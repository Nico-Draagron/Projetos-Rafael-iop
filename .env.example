# Copie este arquivo para .env.local e coloque sua chave (o .env.local NÃO vai para o GitHub).
# Na Vercel, cadastre estas variáveis em Settings → Environment Variables.

# Obrigatória: chave da Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Opcional: modelo da Groq. Veja os modelos de produção em https://console.groq.com/docs/models
# GROQ_MODEL=openai/gpt-oss-120b
